  "components": [
    {
      "name": "Primary Button",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "Main action on a screen or sheet. Ink, never cobalt.",
      "html": "<button class=\"ds-btn-primary\">Save to my programs</button>",
      "css": ".ds-btn-primary{display:inline-flex;align-items:center;gap:8px;height:44px;padding:0 16px;border:0;border-radius:0.75rem;background:var(--color-ink);color:var(--color-on-ink);font:500 1rem/1.375rem system-ui,sans-serif;transition:background-color .15s ease-out,scale .15s ease-out;cursor:pointer}.ds-btn-primary:hover{background:color-mix(in oklab,var(--color-ink) 88%,transparent)}.ds-btn-primary:active{scale:.98}.ds-btn-primary:focus-visible{outline:2px solid var(--color-accent);outline-offset:2px}"
    },
    {
      "name": "Secondary Button",
      "kind": "button",
      "refersTo": "button-secondary",
      "description": "Default button. Tonal well fill.",
      "html": "<button class=\"ds-btn-secondary\">Use a template</button>",
      "css": ".ds-btn-secondary{display:inline-flex;align-items:center;height:44px;padding:0 16px;border:0;border-radius:0.75rem;background:var(--color-surface-2);color:var(--color-ink);font:500 1rem/1.375rem system-ui,sans-serif;transition:background-color .15s ease-out,scale .15s ease-out;cursor:pointer}.ds-btn-secondary:hover{background:var(--color-line)}.ds-btn-secondary:active{scale:.98}.ds-btn-secondary:focus-visible{outline:2px solid var(--color-accent);outline-offset:2px}"
    },
    {
      "name": "Link Button",
      "kind": "button",
      "refersTo": "button-link",
      "description": "Inline action in cobalt, underline on hover.",
      "html": "<button class=\"ds-btn-link\">Why?</button>",
      "css": ".ds-btn-link{background:none;border:0;padding:0;height:36px;color:var(--color-accent);font:500 1rem/1.375rem system-ui,sans-serif;text-underline-offset:4px;cursor:pointer}.ds-btn-link:hover{text-decoration:underline}.ds-btn-link:focus-visible{outline:2px solid var(--color-accent);outline-offset:2px;border-radius:0.5rem}"
    },
    {
      "name": "Filter Chips",
      "kind": "chip",
      "refersTo": "chip",
      "description": "Toggle chips; selected fills ink.",
      "html": "<div class=\"ds-chips\"><button class=\"ds-chip\" aria-pressed=\"true\">Mine <span>24</span></button><button class=\"ds-chip\" aria-pressed=\"false\">Chest</button><button class=\"ds-chip\" aria-pressed=\"false\">Pull</button></div>",
      "css": ".ds-chips{display:flex;gap:8px}.ds-chip{display:inline-flex;align-items:center;gap:6px;height:36px;padding:0 14px;border-radius:9999px;border:1px solid var(--color-line-strong);background:transparent;color:var(--color-ink);font:500 .8125rem/1.125rem system-ui,sans-serif;transition:background-color .15s,border-color .15s,color .15s;cursor:pointer}.ds-chip span{color:var(--color-ink-3);font-variant-numeric:tabular-nums}.ds-chip:hover{background:var(--color-surface-2)}.ds-chip[aria-pressed=\"true\"]{background:var(--color-ink);border-color:var(--color-ink);color:var(--color-on-ink)}.ds-chip[aria-pressed=\"true\"] span{color:color-mix(in oklab,var(--color-on-ink) 70%,transparent)}.ds-chip:focus-visible{outline:2px solid var(--color-accent);outline-offset:2px}"
    },
