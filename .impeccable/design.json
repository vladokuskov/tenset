      "css": ".ds-pill{display:inline-flex;align-items:center;height:24px;padding:0 10px;border-radius:9999px;border:1px solid var(--color-line-strong);color:var(--color-ink-2);font:500 .75rem/1rem system-ui,sans-serif}.ds-pill-soft{border-color:transparent;background:var(--color-surface-2)}"
    },
